    });
  }

  /**
   * Crimson/Wine-Red Battle Tabard / Hanging Sash (Blender woven fabric PBR)
   */
  public createCrimsonSash(): THREE.MeshStandardMaterial {
    return new THREE.MeshStandardMaterial({
