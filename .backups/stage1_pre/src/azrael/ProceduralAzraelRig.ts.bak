          Hips: [0.02, 0.0, 0],
          Spine2: [0.05, 0.0, 0],
          Thigh_L: [-0.05, 0, 0],
          Shin_L: [0.08, 0, 0],
          Thigh_R: [-0.15, 0, 0],
          Shin_R: [0.65, 0, 0],
          UpperArm_R: [-0.52, 0.42, 0.34],
          ForeArm_R: [-1.20, 0.24, 0.46],
