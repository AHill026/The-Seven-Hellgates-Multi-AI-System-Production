          Thigh_R: [0.32, 0, 0],
          Shin_R: [0.35, 0, 0],
          UpperArm_R: [-0.50, 0.42, 0.34],
          ForeArm_R: [-1.18, 0.24, 0.46],
          Hand_R: [0.10, 0.12, 0.38],
          UpperArm_L: [-0.50, 0.18, 0.16],
          ForeArm_L: [-0.82, -0.15, -0.24],
          Cloak_Upper: [0.14, 0, 0],
