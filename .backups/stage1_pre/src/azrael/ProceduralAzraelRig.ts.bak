          Cloak_Upper: [0.14, 0, 0],
        },
      },
    ])
  );

  // 3. RUN — Forward combat sprint with blade trailed right
  clips.push(
    makeClipFromPoses('RUN', 0.72, [
      {
        t: 0,
        hipsOffset: [0, -0.03, 0],
        bones: {
          Hips: [0.16, -0.12, 0],
