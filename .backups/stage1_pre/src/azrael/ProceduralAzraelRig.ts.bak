        },
      },
      {
        t: 0.36,
        hipsOffset: [0, 0.02, 0],
        bones: {
          Hips: [0.16, 0.12, 0],
          Spine: [0.12, -0.05, 0],
          Spine2: [0.14, -0.12, 0],
          Head: [-0.22, 0.05, 0],
