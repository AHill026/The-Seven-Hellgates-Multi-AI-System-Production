        },
      },
      {
        t: 0.6,
        hipsOffset: [0, 0, 0],
        bones: {
          Hips: [0.03, 0.06, 0],
          Spine2: [0.06, -0.08, 0],
          Thigh_L: [0.32, 0, 0],
          Shin_L: [0.35, 0, 0],
          Thigh_R: [-0.38, 0, 0],
          Shin_R: [0.22, 0, 0],
